<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EmployeeCustomerLoginApp.MainPage"
             Title="EmplyeeLogin">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="18"
            VerticalOptions="Center">

            <Label
                Text="Employee Login"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                WidthRequest="300"/>

            <Entry
                x:Name="EmployeeCodeEntry"
                Placeholder="Enter Employee Code"
                Keyboard="Text" 
                WidthRequest="300"/>

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Enter Password"
                IsPassword="True"
                WidthRequest="300"/>

            <Button
                x:Name="LoginButton"
                Text="Login"
                Clicked="OnLoginClicked"
                WidthRequest="100"/>

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False" />

            <Label
                x:Name="MessageLabel"
                TextColor="Red"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
